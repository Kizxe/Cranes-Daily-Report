# Copy this to .env and fill in real values. Never commit .env itself.
# URL is scheme + host + port, no trailing /api (config adds THINGSBOARD_API_PREFIX).
# Live instance is plain HTTP on :8080 — e.g. http://cranes.asia:8080
THINGSBOARD_URL=http://cranes.asia:8080
THINGSBOARD_USERNAME=
THINGSBOARD_PASSWORD=

# --- Report: DOWNTIME EVENTS table caps ---------------------------------
# A flapping device can produce dozens of events a day. These cap what the PDF
# prints; GET /api/downtime/events/{device_id} always has the full list.
REPORT_MAX_EVENTS_PER_DEVICE=8
REPORT_MAX_EVENTS_PER_SITE=40
# 0 = print every event. Raise to ~60 to suppress sub-minute poll flaps.
REPORT_MIN_EVENT_SECONDS=0
